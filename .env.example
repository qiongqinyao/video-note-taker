# === LLM 提供商：deepseek 或 qwen ===
LLM_PROVIDER=deepseek

# DeepSeek 模式（LLM_PROVIDER=deepseek 时需要）
# 从 https://platform.deepseek.com 获取
DEEPSEEK_API_KEY=your_api_key_here

# 千问模式（LLM_PROVIDER=qwen 时使用，每月 100 万 token 免费）
# 从 https://dashscope.console.aliyun.com/apiKey 获取（阿里云账号登录）
# QWEN_API_KEY=your_api_key_here
